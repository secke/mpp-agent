{
  "name": "mpp-agent",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "better-sqlite3": "^12.11.1",
    "hono": "^4.13.8",
    "mppx": "^0.10.1",
    "openai": "^6.49.0",
    "prom-client": "^15.1.3",
    "viem": "^2.56.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx server/index.ts",
    "start": "node --env-file=.env --import tsx server/index.ts",
    "test": "vitest run --exclude \"**/*.e2e.test.ts\"",
    "test:e2e": "vitest run tests/**/*.e2e.test.ts",
    "typecheck": "tsc --noEmit",
    "agent": "node --env-file=.env --import tsx agent/index.ts"
  }
}
