# Copier en .env — .env est gitignored, ne jamais commiter de secret.

# Secret HMAC de liaison des Challenges. >= 32 octets (imposé par mppx).
# Générer : openssl rand -base64 32
MPP_SECRET_KEY=

# Adresse qui encaisse les paiements (compte Tempo testnet).
# Créer : npx mppx account create --account main
#         npx mppx account fund --network testnet
#         npx mppx account view --account main
MPP_RECIPIENT=0x0000000000000000000000000000000000000000

# Realm annoncé dans WWW-Authenticate.
MPP_REALM=localhost

# Prix d'un appel /v1/search, en unités lisibles (max 6 décimales).
MPP_SEARCH_PRICE=0.50

PORT=8787

# Garde-fou : toute autre valeur fait échouer le démarrage.
MPP_NETWORK=testnet

# ─── Agent payeur (phase 2) ───────────────────────────────────────────
# Clé privée du wallet payeur. Distincte de MPP_RECIPIENT : l'agent paie,
# le provider encaisse. Ne jamais commiter, ne jamais logger.
#   npx mppx account create --account agent
#   npx mppx account fund --network testnet --account agent
#   npx mppx account export --account agent
AGENT_PRIVATE_KEY=

# Plafond par appel, en unités lisibles (max 6 décimales).
AGENT_MAX_PER_CALL=1.00

# Enveloppe totale sur la durée de vie du guard.
AGENT_TOTAL_BUDGET=10.00

# Liste blanche de destinataires, séparés par des virgules. Vide = tous.
AGENT_ALLOWED_RECIPIENTS=

AGENT_PROVIDER_URL=http://localhost:8787

# ─── Ledger (phase 3) ─────────────────────────────────────────────────
# Fichier SQLite du journal d'audit. `:memory:` pour une base éphémère.
LEDGER_PATH=data/ledger.sqlite

# ─── Modèle LLM (phase 4) ─────────────────────────────────────────────
# DeepSeek expose une API compatible OpenAI.
# Source : https://api-docs.deepseek.com/
# Modèles disponibles : deepseek-flash, deepseek-v4-pro
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_TOKENS=1024
# Mode « thinking » de DeepSeek. Désactivé par défaut : coûteux en tokens
# de raisonnement, sans bénéfice pour une boucle d'outils aussi cadrée.
DEEPSEEK_THINKING=false
