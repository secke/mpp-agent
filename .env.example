# Copy to .env — .env is gitignored, never commit a secret.

# HMAC secret binding Challenges. >= 32 bytes (enforced by mppx).
# Generate: openssl rand -base64 32
MPP_SECRET_KEY=

# Address that collects the payments (Tempo testnet account).
# Create: npx mppx account create --account main
#         npx mppx account fund --network testnet
#         npx mppx account view --account main
MPP_RECIPIENT=0x0000000000000000000000000000000000000000

# Realm advertised in WWW-Authenticate.
MPP_REALM=localhost

# Price of a /v1/search call, in readable units (max 6 decimals).
MPP_SEARCH_PRICE=0.50

PORT=8787

# Guard: any other value makes startup fail.
MPP_NETWORK=testnet

# ─── Paying agent (phase 2) ───────────────────────────────────────────
# Private key of the paying wallet. Distinct from MPP_RECIPIENT: the agent
# pays, the provider collects. Never commit, never log.
#   npx mppx account create --account agent
#   npx mppx account fund --network testnet --account agent
#   npx mppx account export --account agent
AGENT_PRIVATE_KEY=

# Per-call cap, in readable units (max 6 decimals).
AGENT_MAX_PER_CALL=1.00

# Total envelope over the guard's lifetime.
AGENT_TOTAL_BUDGET=10.00

# Recipient allowlist, comma-separated. Empty = any.
AGENT_ALLOWED_RECIPIENTS=

AGENT_PROVIDER_URL=http://localhost:8787

# ─── Ledger (phase 3) ─────────────────────────────────────────────────
# SQLite file of the audit log. `:memory:` for an ephemeral database.
LEDGER_PATH=data/ledger.sqlite

# ─── LLM model (phase 4) ──────────────────────────────────────────────
# DeepSeek exposes an OpenAI-compatible API.
# Source: https://api-docs.deepseek.com/
# Available models: deepseek-flash, deepseek-v4-pro
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_TOKENS=1024
# DeepSeek "thinking" mode. Disabled by default: costly in reasoning
# tokens, with no benefit for such a tightly framed tool loop.
DEEPSEEK_THINKING=false

# ─── Hardening (phase 8) ──────────────────────────────────────────────
# Replay store: sqlite (default) | redis | memory
# `memory` is the mppx default but is neither shared between processes
# nor durable — a Credential becomes replayable again after a restart.
# It therefore requires an explicit acknowledgement.
REPLAY_STORE=sqlite
REPLAY_STORE_PATH=data/replay.sqlite
# REDIS_URL=redis://127.0.0.1:6379
# REPLAY_STORE_MEMORY_ACK=i-know

# Price of /v1/analyze (POST route whose body is bound to the Challenge).
MPP_ANALYZE_PRICE=1.00

# Bearer token for /metrics (>= 16 chars). Absent: /metrics is disabled.
# METRICS_TOKEN=
